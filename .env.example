# Copy this file to ".env" and fill in the two values from your Supabase project:
# Supabase dashboard > Project Settings > API Keys (and "Data API" for the URL).
#
# Both of these are safe to ship inside the app. NEVER put the "secret" or
# "service_role" key in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
